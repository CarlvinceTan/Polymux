# Copy to `.env` — it is git-ignored and read by the development launcher.
#
# Client ids for the drive providers that sign in with OAuth. A provider whose
# id is missing reports itself as unavailable rather than offering a connect
# button that could only fail, so you only need the ones you actually use.
#
# Register each as a **desktop/native** client with the redirect URI
#   http://127.0.0.1:47665/drive/callback
# The port is fixed because Dropbox and Microsoft match redirect URIs exactly.
#
# Native apps are public clients and usually get no secret; every flow uses
# PKCE regardless, so the _CLIENT_SECRET lines stay commented out unless the
# provider actually issued one.

POLYMUX_GOOGLE_DRIVE_CLIENT_ID=
# POLYMUX_GOOGLE_DRIVE_CLIENT_SECRET=

POLYMUX_DROPBOX_CLIENT_ID=
# POLYMUX_DROPBOX_CLIENT_SECRET=

POLYMUX_ONEDRIVE_CLIENT_ID=
# POLYMUX_ONEDRIVE_CLIENT_SECRET=

# Client ids for signing in to a mailbox. By default Polymux reuses the Google
# Drive and OneDrive desktop registrations above; mail still opens its own
# consent flow, so connecting Drive never grants access to email. A Google
# Drive client that issued a secret is reused with that secret; Microsoft
# mail stays a public client and does not send the OneDrive secret. Add the
# mail variables below only when the provider requires a separate registration.
# Whichever registration is used must also include the redirect URI
# http://127.0.0.1:47666/mail/callback — one port along from the drive flow, so
# connecting a drive and a mailbox at the same moment cannot collide.
#
# Google's IMAP scope (https://mail.google.com/) is restricted, so a client
# using it needs Google's verification before anyone outside the test users can
# sign in. Microsoft's IMAP.AccessAsUser.All and SMTP.Send do not.
# POLYMUX_GOOGLE_MAIL_CLIENT_ID=
# POLYMUX_GOOGLE_MAIL_CLIENT_SECRET=
# POLYMUX_MICROSOFT_MAIL_CLIENT_ID=
# POLYMUX_MICROSOFT_MAIL_CLIENT_SECRET=
# Telegram application identity embedded into desktop builds. Users still sign
# in to their own Telegram account; these remove the per-user API ID/hash step.
POLYMUX_TELEGRAM_API_ID=
POLYMUX_TELEGRAM_API_HASH=
# Optional replacement for Polymux's bundled WeChat writer. The built-in writer
# contains exact-build paths for text, images, native stickers, files, videos,
# SILK voice messages, replies, and recall, and only reports a send as successful
# after it appears in WeChat history.
# POLYMUX_WECHAT_WRITER=/absolute/path/to/Polymux/scripts/wechat/polymux-wechat-driver.mjs
# Development-only native packet gate. Packaged Polymux enables this for its
# bundled writer automatically; direct script probes must opt in explicitly.
# POLYMUX_WECHAT_WIRE_NATIVE=1
# Second, explicit safety gate for direct LLDB task probes. Packaged Polymux
# supplies this only to its bundled writer; do not enable it for ordinary runs.
# POLYMUX_WECHAT_LLDB_EXPERIMENTAL=1
# Override the paths the wire injector uses to gate on the exact WeChat build
# and to attach its debugger. Defaults are WeChat.app's bundled wechat.dylib
# and the system `lldb`; set these only when either lives at a non-default path.
# POLYMUX_WECHAT_DYLIB=/Applications/WeChat.app/Contents/Resources/wechat.dylib
# POLYMUX_WECHAT_LLDB=lldb
# Optional override for the bundled audio/video preparation helper.
# POLYMUX_WECHAT_MEDIA_PREPARE=/absolute/path/to/wechat-media-prepare
# Override the `wechat-use` CLI path. Exclusive: when set, no other
# candidate path is tried.
# Native-only mode never invokes wechat-use or its relay. Requires a validated
# Polymux store registry; fresh automatic key capture is not yet supported.
# POLYMUX_WECHAT_PROVIDER=native
# POLYMUX_WECHAT_CLI=/absolute/path/to/wechat-use
# Extra directory searched for the wechat-bridge/wechat-use binaries.
# POLYMUX_WECHAT_BIN=/absolute/path/to/bin
# Loopback port the wechat-bridge relay binds. Default 18400.
# POLYMUX_WECHAT_RELAY_PORT=18400
# Named development isolates disable external WeChat discovery and integration
# by default, including the ordinary account's native stores, relay and media.
# Set 1 only for intentional live-account QA; this uses real WeChat state.
# POLYMUX_WECHAT_ISOLATE_LIVE=1
# Native WeChat conversations, history, and inbound WAL stream default on.
# Requires one keyed account; missing/ambiguous keys fall back to the relay.
# Set 0 to explicitly use only the relay.
# POLYMUX_WECHAT_NATIVE_INBOUND=0
# Exact registry file for clean-room SQLCipher keys (one 32-byte key per
# database, see scripts/wechat/wechat-key-collect.mjs). Defaults to
# ~/Library/Application Support/Polymux/wechat/store.json on macOS.
# POLYMUX_WECHAT_STORE_REGISTRY=/absolute/path/to/store.json
# Internal native-operation pins, supplied automatically by the relay lease.
# Both are required together; drivers refuse a replacement process. Do not
# configure these for routine use. IDENTITY is captured from lstart + executable.
# POLYMUX_WECHAT_TARGET_PID=<captured-pid>
# POLYMUX_WECHAT_TARGET_IDENTITY=<captured-process-identity>
# Debug-only path where the native injector records its manager capture.
# POLYMUX_WECHAT_MANAGER_CAPTURE_PATH=/absolute/path/to/capture.json
# During live development this hard-stops any accidental send outside WeChat's
# File Transfer conversation.
# POLYMUX_WECHAT_TEST_ONLY_FILEHELPER=1
# Optional exact native IDs for a controlled multi-chat test. Both fences apply if both are set.
# POLYMUX_WECHAT_TEST_CHAT_IDS=filehelper,123456@chatroom
# The released wechatd build omits its LLDB CDN request hook. When the app
# starts wechatd it points it at the copy shipped with Polymux automatically;
# set this only to substitute a helper of your own, or when starting wechatd
# by hand outside the app.
# WECHAT_CDN_CAPTURE_SCRIPT=/absolute/path/to/Polymux/scripts/wechat/wxcdn_fileid_capture.py
# Test-only fallback for validating a captured CDN file path without a complete
# native request. Never enable this for an ordinary desktop run.
# WECHAT_CDN_CAPTURE_ALLOW_FILE_PATH_ONLY=1

# Personal Polymux Host. The listener stays on loopback and connects outbound to
# https://connect.polymux.com by default. Set a different relay for development,
# or use "off" only when providing your own private HTTPS endpoint. A Host
# accepts exactly one paired Desktop or phone identity.
# POLYMUX_HOST_LISTEN=127.0.0.1
# POLYMUX_HOST_PORT=47680
# POLYMUX_HOST_RELAY_ENDPOINT=https://connect.polymux.com
# POLYMUX_HOST_PUBLIC_ENDPOINT=https://host.example.com
# Agent surface loopback (browser extension + Locker feed). The desktop app
# listens here and the extension connects to it. Override only when the
# default port collides with something else on the machine.
# POLYMUX_AGENT_SURFACE_PORT=47654
# Desktop update feed. The app checks this URL for releases; the publish
# script uploads there (POLYMUX_UPDATE_HOST) with these release notes.
# POLYMUX_UPDATE_FEED_URL=https://polymux.com/api/releases
# POLYMUX_UPDATE_HOST=https://polymux.com/api/releases
# POLYMUX_RELEASE_NOTES=
# Headless CLI deployments also read these values from
# ~/.local/share/polymux/config/host.env on Linux. Select the model explicitly;
# provider keys use their ordinary environment variable names.
# POLYMUX_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# CLI password input (export only for the command that needs it; these are not
# Host service settings). Hidden prompts and --password-stdin /
# --password-value-stdin / --new-stdin also avoid secret command-line values.
# POLYMUX_LOCKER_PASSWORD=
# POLYMUX_LOCKER_NEW_PASSWORD=
# POLYMUX_LOCKER_ITEM_PASSWORD=
# POLYMUX_EMAIL_PASSWORD=

# Polymux account (optional sign-in). A Supabase project backing email/password
# and Google/Apple sign-in plus same-account device discovery. The publishable
# key is safe to ship; the URL and key are baked into packaged builds at build
# time and read from this file in development.
# POLYMUX_SUPABASE_URL=https://zeparkyoyqvjzavrejsa.supabase.co
# POLYMUX_SUPABASE_ANON_KEY=
# CLI builds embed these same public account settings. A headless Host can
# override them in its config/host.env; restart the Host after changing them.
# Google/Apple CLI login reuses http://127.0.0.1:47667/auth/callback.
#
# Locker uses this same account. The cloud object is the encrypted KeePass
# vault; nothing in Supabase rows is a plaintext password or TOTP secret.
# Desktop, the browser extension, and the phone app all sign in here. The
# extension and phone bake the URL/key the same way packaged desktop does.
# Rotating the project means rebuilding every store artifact, and updating
# the exact-host allowlist in apps/phone/src-tauri/capabilities/default.json
# (wildcard hosts are rejected by the transport contract test and by App
# Store review expectations):
# from this file in development, and from the environment at pack/build.
#
# Google and Apple sign-in need OAuth client credentials in the Supabase
# dashboard. Register this redirect on each provider:
#   https://zeparkyoyqvjzavrejsa.supabase.co/auth/v1/callback
# and allow these return URLs (also in supabase/config.toml):
#   http://127.0.0.1:47667/auth/callback
#   https://abcoknklbjpjkchpejlfpkjlajmifgnk.chromiumapp.org/
#   https://b317c003679330c5436e1227cc2bb7288b72d0b3.extensions.allizom.org/
#   http://127.0.0.1/mozoauth2/b317c003679330c5436e1227cc2bb7288b72d0b3
# Firefox packed add-on id is extension@polymux.com; the URL is SHA-1 of that
# id as a subdomain of extensions.allizom.org (browser.identity.getRedirectURL()).
# Unpacked Chrome uses a different extension id; https://*.chromiumapp.org/**
# covers it. Safari has no identity redirect in this codebase.
#
# Branded auth emails live in supabase/email-templates/. Hosted Supabase only
# applies them once a custom SMTP provider is configured (the default mailer
# on the free plan cannot change templates).
# iPhone completion notifications. Keep the APNs .p8 key outside the repository.
POLYMUX_APNS_KEY_PATH=
POLYMUX_APNS_KEY_ID=
POLYMUX_APNS_TEAM_ID=

# Conversation sharing (site server only; never expose the token to the desktop).
# Provision a Redis REST database with EVAL and expiring keys in the site deployment.
# SHARES_REDIS_REST_URL=https://your-database.upstash.io
# SHARES_REDIS_REST_TOKEN=

# Renderer test isolation (pass as command environment variables).
# POLYMUX_UI_TEST_PORT=4173
# Playwright sets this automatically from its port; manual browser builds may
# set a unique key to keep output outside the normal app's .vite directory.
# POLYMUX_RENDERER_OUTPUT_KEY=manual-test

# Native browser host (installer-owned; do not set these in .env).
# apps/extension/install.sh embeds POLYMUX_EXTENSION_ID and POLYMUX_NATIVE_BROWSER
# in its launcher to validate Chromium origins or the fixed Firefox add-on ID.
# The Locker capability is generated privately by desktop, never configured here.
