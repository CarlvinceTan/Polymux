{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "forge.config.ts",
    "forge.env.d.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "packages/**/*.ts",
    "vite.*.config.ts"
  ]
}
