+                    "--no-prompt", "--output", proof.appendingPathComponent("launch.trace").path,
+                    "--env", "POLYMUX_DATA_DIR=\(proof.appendingPathComponent("data").path)",
+                    "--launch", "--", release.path, "-serverAddress", "http://127.0.0.1:48739"]
+        try ("/usr/bin/xcrun " + args.joined(separator: " ") + "\n").write(to: log, atomically: true, encoding: .utf8)
+        let output = try FileHandle(forWritingTo: log)
+        try output.seekToEnd()
+        let recorder = Process()
+        recorder.executableURL = URL(fileURLWithPath: "/usr/bin/xcrun")
+        recorder.arguments = args
+        recorder.standardOutput = output
+        recorder.standardError = output
+        try recorder.run()
+        defer {
+            recorder.waitUntilExit()
+            try? output.write(contentsOf: Data("\nExit: \(recorder.terminationStatus)\n".utf8))
+            try? output.close()
+            app.terminate()
+        }
+        XCTAssertTrue(app.wait(for: .runningForeground, timeout: 15))
+        app.activate()
