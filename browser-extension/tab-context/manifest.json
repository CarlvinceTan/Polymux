{
  "manifest_version": 3,
  "name": "FlareAI Agent Surface",
  "version": "1.1.0",
  "description": "Gives the FlareAI desktop agent tab context and lets it control leased tabs, with Codex-style badges and the ChatGPT-style cursor.",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1:47654/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["cursor-motion.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
