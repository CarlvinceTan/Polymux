<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, which notarisation requires.

  Each one is here because Polymux stops working without it, not because it is
  conventional: an entitlement is a permission the app is asking for, and the
  list should read as the shortest honest answer to "why does it need that".
-->
<plist version="1.0">
<dict>
  <!-- Electron compiles JavaScript at runtime; V8 cannot start without both. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Scanning a device pairing QR code at the user’s request. -->
  <key>com.apple.security.device.camera</key>
  <true/>

  <!-- Voice input and speech mode. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!--
    Driving other applications: the window-control and messaging routes read
    and control apps the user already has open. macOS prompts per application
    the first time regardless; this only makes the request possible.
  -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>

  <!--
    The bridge fleet is a set of separate executables Polymux spawns as child
    processes. They are signed with the same identity during packaging, but a
    hardened parent still needs this to launch them.
  -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The team-qualified WebAuthn keychain access group is injected from the
       actual signing certificate by forge.config.ts. It cannot be static:
       local Apple Development and release Developer ID builds use different
       Apple team identifiers. -->
</dict>
</plist>
