{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ESNext"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts",
    "../desktop/src/renderer/polymux.d.ts",
    "../desktop/src/renderer/vite-env.d.ts"
  ]
}
