{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ESNext",
    "paths": {
      "@polymux/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts"
  ]
}
