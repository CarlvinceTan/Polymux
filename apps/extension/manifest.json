{
  "manifest_version": 3,
  "name": "Polymux",
  "version": "0.2.2",
  "description": "Lets Polymux see open-tab metadata and securely control only the browser tabs assigned to it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:47654/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/cursor-motion.js",
        "shared/cursor-overlay.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
