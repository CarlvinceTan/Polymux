{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polymux-connect",
  "account_id": "05e23b23b8a67cdd05a27e61dc0c0b08",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "HOST_RELAY", "class_name": "HostRelay"},
      {"name": "CONNECT_CODES", "class_name": "ConnectCodeRegistry"},
      {"name": "CONNECT_LIMITER", "class_name": "ConnectAttemptLimiter"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["HostRelay"]},
    {"tag": "v2", "new_sqlite_classes": ["ConnectCodeRegistry", "ConnectAttemptLimiter"]}
  ],
  "observability": {
    "enabled": true,
    "logs": {"head_sampling_rate": 1},
    "traces": {"enabled": true, "head_sampling_rate": 0.05}
  }
}
