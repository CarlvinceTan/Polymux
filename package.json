{
  "name": "polymux-desktop",
  "productName": "Polymux",
  "version": "0.2.3",
  "description": "Agent-agnostic desktop workspace",
  "author": "Carlvince Tan",
  "main": ".vite/build/main.js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prestart": "node scripts/dev-app-name.mjs",
    "start": "node scripts/dev-start.mjs",
    "isolate": "node scripts/dev-start.mjs --isolated",
    "prenew:start": "node scripts/dev-app-name.mjs",
    "new:start": "node scripts/dev-start.mjs --new",
    "dev": "vite --config apps/desktop/vite.renderer.config.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:appimage": "electron-builder --linux AppImage --x64 --prepackaged out/Polymux-linux-x64 --publish never",
    "publish": "electron-forge publish",
    "check": "svelte-check --tsconfig ./apps/desktop/src/renderer/tsconfig.json && tsc --noEmit",
    "build": "vite build --config apps/desktop/vite.renderer.config.ts",
    "preview": "vite preview --config apps/desktop/vite.renderer.config.ts",
    "test:ui": "playwright test --config apps/desktop/src/renderer/playwright.config.ts",
    "test:storage": "tsx --test packages/storage/test/**/*.test.ts",
    "test:computer": "tsx --test packages/computer/test/**/*.test.ts",
    "test:inference": "tsx --test packages/inference/test/**/*.test.ts",
    "test:core": "tsx --test packages/core/test/**/*.test.ts",
    "test:agent": "tsx --test packages/agent/test/**/*.test.ts",
    "test:tools": "tsx --test packages/tools/test/**/*.test.ts",
    "test:protocol": "tsx --test packages/protocol/test/**/*.test.ts",
    "test:hub": "tsx --test packages/hub/test/**/*.test.ts",
    "test:drive": "tsx --test packages/drive/test/**/*.test.ts",
    "test:main": "tsx --test apps/desktop/src/main/**/*.test.ts",
    "test:renderer": "tsx --test apps/desktop/src/renderer/**/*.test.ts",
    "test:browser": "tsx --test packages/browser/test/**/*.test.ts",
    "test:browser-live": "POLYMUX_LIVE_BROWSER=1 tsx --test packages/browser/test/live.test.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:preview-live": "esbuild apps/desktop/src/main/workspace/preview.ts --bundle --format=esm --platform=node --outfile=.vite/preview-live/preview.mjs && electron scripts/preview-live.mjs",
    "test": "npm run test:scripts && npm run test:inference && npm run test:core && npm run test:storage && npm run test:computer && npm run test:tools && npm run test:agent && npm run test:protocol && npm run test:hub && npm run test:drive && npm run test:browser && npm run test:main && npm run test:renderer",
    "icons": "node scripts/build-icons.mjs",
    "bridges": "node scripts/fetch-bridges.mjs",
    "updates": "node scripts/publish-updates.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "@polymux/agent": "0.1.0",
    "@polymux/computer": "0.1.0",
    "@polymux/drive": "0.1.0",
    "@polymux/hub": "0.1.0",
    "@polymux/inference": "0.1.0",
    "@polymux/protocol": "0.1.0",
    "@polymux/storage": "0.1.0",
    "@polymux/tools": "0.1.0",
    "dompurify": "^3.4.13",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "imapflow": "^1.7.1",
    "marked": "^18.0.9",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.6",
    "smol-toml": "^1.8.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "simple-icons": "^16.28.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tslib": "^2.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.5"
  },
  "config": {
    "forge": "./apps/desktop/forge.config.ts"
  },
  "build": {
    "appId": "com.flarehq.polymux",
    "productName": "Polymux",
    "directories": {
      "output": "out/make/appimage"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Polymux-${version}-${arch}.${ext}",
      "category": "Utility"
    },
    "publish": {
      "provider": "generic",
      "url": "https://polymux.com/api/updates/linux/x64"
    }
  }
}
