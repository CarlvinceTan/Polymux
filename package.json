{
  "name": "flareai-desktop",
  "productName": "FlareAI",
  "version": "0.2.0",
  "description": "FlareAI desktop agent",
  "main": ".vite/build/main.js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prestart": "node scripts/dev-app-name.mjs",
    "start": "node scripts/dev-start.mjs",
    "isolate": "node scripts/dev-start.mjs --isolated",
    "prenew:start": "node scripts/dev-app-name.mjs",
    "new:start": "node scripts/dev-start.mjs --new",
    "prenew:onboarding": "node scripts/dev-app-name.mjs",
    "new:onboarding": "FLAREAI_ONBOARDING=1 node scripts/dev-start.mjs --new",
    "onboarding": "FLAREAI_ONBOARDING=1 node scripts/dev-start.mjs",
    "dev": "vite --config apps/desktop/vite.renderer.config.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "svelte-check --tsconfig ./apps/desktop/src/renderer/tsconfig.json && tsc --noEmit",
    "build": "vite build --config apps/desktop/vite.renderer.config.ts",
    "preview": "vite preview --config apps/desktop/vite.renderer.config.ts",
    "test:ui": "playwright test --config apps/desktop/src/renderer/playwright.config.ts",
    "test:storage": "tsx --test packages/storage/test/**/*.test.ts",
    "test:computer-history": "tsx --test packages/computer-history/test/**/*.test.ts",
    "test:inference": "tsx --test packages/inference/test/**/*.test.ts",
    "test:core": "tsx --test packages/core/test/**/*.test.ts",
    "test:agent": "tsx --test packages/agent/test/**/*.test.ts",
    "test:tools": "tsx --test packages/tools/test/**/*.test.ts",
    "test:protocol": "tsx --test packages/protocol/test/**/*.test.ts",
    "test:hub": "tsx --test packages/hub/test/**/*.test.ts",
    "test:drive": "tsx --test packages/drive/test/**/*.test.ts",
    "test:main": "tsx --test apps/desktop/src/main/**/*.test.ts",
    "test:renderer": "tsx --test apps/desktop/src/renderer/**/*.test.ts",
    "test:browser": "tsx --test packages/browser/test/**/*.test.ts",
    "test:browser-live": "FLAREAI_LIVE_BROWSER=1 tsx --test packages/browser/test/live.test.ts",
    "test:preview-live": "esbuild apps/desktop/src/main/workspace/preview.ts --bundle --format=esm --platform=node --outfile=.vite/preview-live/preview.mjs && electron scripts/preview-live.mjs",
    "test": "npm run test:inference && npm run test:core && npm run test:storage && npm run test:computer-history && npm run test:tools && npm run test:agent && npm run test:protocol && npm run test:hub && npm run test:drive && npm run test:browser && npm run test:main && npm run test:renderer",
    "icons": "node scripts/build-icons.mjs",
    "bridges": "node scripts/fetch-bridges.mjs",
    "updates": "node scripts/publish-updates.mjs",
    "memories": "tsx scripts/import-codex-memories.mts",
    "eval:orchestration": "node experiments/orchestration-eval/analyze-runs.mjs",
    "eval:orchestration:probe": "node experiments/orchestration-eval/probe-provider.mjs",
    "eval:orchestration:prepare-fixture": "node experiments/orchestration-eval/prepare-fixture.mjs",
    "eval:orchestration:prepare-fixtures": "node experiments/orchestration-eval/prepare-fixtures.mjs",
    "eval:orchestration:prepare-memory": "node experiments/orchestration-eval/prepare-memory-clones.mjs",
    "eval:orchestration:prepare-skills": "node experiments/orchestration-eval/prepare-skill-clones.mjs",
    "eval:orchestration:prepare-current-page": "node experiments/orchestration-eval/prepare-current-page.mjs",
    "eval:orchestration:prepare-roles": "node experiments/orchestration-eval/prepare-roles.mjs",
    "eval:orchestration:run": "node experiments/orchestration-eval/run-scenario.mjs",
    "eval:orchestration:form-probe": "node experiments/orchestration-eval/run-form-probe.mjs",
    "eval:orchestration:dependent-probe": "node experiments/orchestration-eval/run-dependent-probe.mjs",
    "eval:orchestration:goal-probe": "node experiments/orchestration-eval/run-goal-probe.mjs",
    "eval:orchestration:matrix": "node experiments/orchestration-eval/run-matrix.mjs",
    "eval:orchestration:collect": "node experiments/orchestration-eval/collect-results.mjs",
    "eval:orchestration:blind": "node experiments/orchestration-eval/prepare-blind-review.mjs",
    "eval:orchestration:apply-review": "node experiments/orchestration-eval/apply-blind-review.mjs",
    "eval:orchestration:merge-reviews": "node experiments/orchestration-eval/merge-blind-reviews.mjs",
    "eval:orchestration:gate": "node experiments/orchestration-eval/promotion-gate.mjs",
    "eval:orchestration:assistant-gate": "node experiments/orchestration-eval/assistant-baseline-gate.mjs",
    "eval:orchestration:prepare-assistant": "node experiments/orchestration-eval/prepare-assistant-comparison.mjs",
    "eval:orchestration:final-gate": "node experiments/orchestration-eval/final-promotion-gate.mjs",
    "eval:orchestration:report": "node experiments/orchestration-eval/final-report.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@flareai/agent": "0.1.0",
    "@flareai/computer-history": "0.1.0",
    "@flareai/drive": "0.1.0",
    "@flareai/hub": "0.1.0",
    "@flareai/inference": "0.1.0",
    "@flareai/protocol": "0.1.0",
    "@flareai/storage": "0.1.0",
    "@flareai/tools": "0.1.0",
    "dompurify": "^3.4.13",
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.12.0",
    "imapflow": "^1.7.1",
    "marked": "^18.0.9",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.6",
    "smol-toml": "^1.8.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.185.4",
    "electron": "43.4.0",
    "prettier": "^3.9.6",
    "simple-icons": "^16.28.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tslib": "^2.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.5"
  },
  "config": {
    "forge": "./apps/desktop/forge.config.ts"
  }
}
